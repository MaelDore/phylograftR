                            x = tip_data,
                            model = "BM")
 # Extract evolutionary rate = sigma²
 sigma2 <- BM_fit$sig2

 # Simulate 100 continuous stochastic maps for the same trait data and BM model
 my_contsimmap <- contsimmap::make.contsimmap(
     tree = toy_backbone,
     trait.data = tip_data,
     Xsig2 = list(sigma2),
     nsim = 100)
